# ── Postgres ───────────────────────────────────────────────
POSTGRES_USER=mtazamo
POSTGRES_PASSWORD=mtazamo_dev_pw
POSTGRES_DB=mtazamo
POSTGRES_PORT=5433

# ── Backend (Laravel / PHP) ────────────────────────────────
# Laravel's own config lives in backend/.env. Inside docker-compose the DB
# host is the service name "db" on port 5432; these are passed through to the
# backend container. BACKEND_PORT maps the host port to Laravel on :4000.
BACKEND_PORT=4000

# ── Frontend ───────────────────────────────────────────────
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:4000
